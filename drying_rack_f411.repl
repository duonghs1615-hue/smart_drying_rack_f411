using "platforms/cpus/stm32f4.repl"

// STM32F411 project clock: HSI = 16 MHz
nvic:
    systickFrequency: 16000000

timer4:
    frequency: 16000000

timer5:
    frequency: 16000000

// Sensors - active high
RainSensor: Miscellaneous.Button @ gpioPortA
    -> gpioPortA@1

LightSensor: Miscellaneous.Button @ gpioPortA
    -> gpioPortA@4

// Buttons - active high
ModeButton: Miscellaneous.Button @ gpioPortB
    -> gpioPortB@0

ManualInButton: Miscellaneous.Button @ gpioPortB
    -> gpioPortB@1

ManualOutButton: Miscellaneous.Button @ gpioPortB
    -> gpioPortB@2

// LCD1602 + I2C backpack
// Firmware uses I2C1 and address 0x27
LCD16x2: Miscellaneous.HD44780I2CMock @ i2c1 0x27
using "platforms/cpus/stm32f4.repl"

// STM32F411 project clock: HSI = 16 MHz
nvic:
    systickFrequency: 16000000

timer4:
    frequency: 16000000

timer5:
    frequency: 16000000

// Sensors - active high
RainSensor: Miscellaneous.Button @ gpioPortA
    -> gpioPortA@1

LightSensor: Miscellaneous.Button @ gpioPortA
    -> gpioPortA@4

// Buttons - active high
ModeButton: Miscellaneous.Button @ gpioPortB
    -> gpioPortB@0

ManualInButton: Miscellaneous.Button @ gpioPortB
    -> gpioPortB@1

ManualOutButton: Miscellaneous.Button @ gpioPortB
    -> gpioPortB@2

// LCD 16x2 (HD44780, 4-bit mode)
// PB8  -> RS  (LCD input 0)
// PB9  -> E   (LCD input 1)
// PB12 -> D4  (LCD input 2)
// PB13 -> D5  (LCD input 3)
// PB14 -> D6  (LCD input 4)
// PB15 -> D7  (LCD input 5)
LCD16x2: Miscellaneous.HD44780Mock @ gpioPortB

gpioPortB:
    8  -> LCD16x2@0
    9  -> LCD16x2@1
    12 -> LCD16x2@2
    13 -> LCD16x2@3
    14 -> LCD16x2@4
    15 -> LCD16x2@5
